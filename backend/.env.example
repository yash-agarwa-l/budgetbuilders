NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://budgetbuilders:budgetbuilders@localhost:5432/budgetbuilders
DATABASE_SSL=false

# Optional. Without it rate limit counters are per-process only.
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32
ACCESS_SECRET=replace-me-with-at-least-32-characters
REFRESH_SECRET=replace-me-with-a-different-32-char-value
ACCESS_EXPIRY=15m
REFRESH_EXPIRY=30d

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# console prints the code to the log; smtp sends real mail.
MAIL_TRANSPORT=console
MAIL_FROM=BudgetBuilders <no-reply@budgetbuilders.in>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

LOG_LEVEL=info
